package deltic:backpressure-probe;

/// Exercises the canonical `backpressure.inc`/`backpressure.dec` built-ins
/// (PLAN.md §6: backpressure is a direct port of the reference structures)
/// around a suspension point, so the host can observe backpressure state
/// toggling independently of task resolution.
world backpressure-probe {
  /// Sets backpressure, yields once (a real suspension point while
  /// backpressure is asserted), clears backpressure, then returns `x`
  /// unchanged.
  export toggle-around-yield: async func(x: u32) -> u32;
}
