// REDUCED vendored dep: wasi:http's types.wit uses only `duration` from
// wasi:clocks/types. The full rc clocks package is not needed by the
// http-fetch fixture world, so this carries exactly the one type.
package wasi:clocks@0.3.1;

interface types {
  /// A duration of time, in nanoseconds.
  type duration = u64;
}
