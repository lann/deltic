package polyengine:async-probe;

/// Component Model 0.3 async probe. Exercises the async-lift ABI
/// (callback + task.return), the canonical `yield` builtin, and the
/// stream/future payload intrinsics — all as exports so the component
/// stays a pure reactor with zero imports.
world async-probe {
  /// Suspends at least once (canonical `yield`), then returns x * 2.
  export wait-then-double: async func(x: u32) -> u32;
  /// Consumes an entire stream of u32s, returns their sum.
  export sum-stream: async func(values: stream<u32>) -> u64;
  /// Awaits the future, adds y to the value it yields.
  export future-add: async func(f: future<u32>, y: u32) -> u32;
}
